  "asserts": [
    {
      "claim": "waveform-alphabet-is-exact",
      "status": "measured",
      "statement": "Every drawn sign-mark decomposes into waveshape x phase x datum with no residue, and the corpus performs both of the operations that decomposition implies.",
      "success_condition": "Already measured. What would extend it is a reason the three waveshapes should be triangle, square and sine rather than any other three -- the completion result (curve-pair-is-the-circle) is the nearest thing and does not reach it.",
      "scope": "About the ALPHABET being generated by those three parameters, and about the corpus drawing the inversions and datum-additions out in full. Says nothing about whether the acoustic SEMANTICS are intended -- that is the domain question, and `the-domain-is-an-axis` answers it.",
      "finding": "F133"
    },
    {
      "claim": "the-domain-is-an-axis",
      "status": "measured",
      "statement": "The corpus varies the interpretive DOMAIN the way it varies any other feature, so no reading of the marks is privileged and none can be.",
      "scope": "About whether a domain can be privileged, not about whether the acoustic one is attested. It is: Sol-Center labels its two lateral axes Frequency and Level and names its centre cells Harmony and Discord, and ZodiacSignSymbols carries a Cromatic Tone column.",
      "finding": "F134 -> F139"
    }
  ]
