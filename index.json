  "notation_system": {
    "name": "Universal Writing System (UWS)",
    "proof_status": "retired_2026-08 — presented as a design choice, not a proof of necessity",
    "sorts": ["entity", "relation", "modifier", "assertion"],
    "operations": 13,
    "geometric_primitives": ["point", "line", "angle", "curve", "enclosure"],
    "semantic_labels_by_design": ["existence", "relation", "quality", "process", "concept"],
    "modal_extension": {
      "defined_operators": ["necessary", "possible", "counterfactual"],
      "new_primitives": 0,
      "distinguished_elements": 7
    },
    "performative_extension": {
      "force_parameter": ["assert", "query", "direct", "commit", "express", "declare"],
      "new_operations": 0,
      "distinguished_elements": 2
    }
  },

  "emergence_investigation": {
    "plan": "docs/planning/emergence-investigation/PLAN.md",
    "status": "in_progress",
    "phases": 6,
    "current_phase": 1,
    "findings_so_far": [
      "From-scratch minimality analysis (Montague grammar) gives 2 base types as the minimal signature for compositional relational semantics, not the notation's 4/5/13 counts",
      "Non-human evidence exists for partial pieces (honeybee waggle-dance geometric encoding of direction/distance; Bengalese finch bounded hierarchical song syntax) but not yet for full relational-algebra structure (negation/quantification/embedding) outside humans",
      "Working hypothesis grounded in Peircean semiotics/biosemiotics: meaning requires an interpretant, may be coextensive with life independent of species, but is not a property of inanimate matter"
    ]
  },

  "writing_system": {
